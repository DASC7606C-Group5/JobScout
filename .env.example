# Local development defaults to SQLite. Use a PostgreSQL URL when deploying.
DATABASE_URL=sqlite://jobscout.sqlite3

# Native async DeepSeek. Keep real credentials server-side in local .env only.
# Startup permits a missing key; model operations fail explicitly without one. No demo fallback.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# Total seconds per structured call, INCLUDING its single retry and repair (max 180).
LLM_TIMEOUT=30
LLM_MAX_TOKENS=4096
# Seconds before the one transient-error retry (0-5); shares the same timeout.
LLM_RETRY_DELAY=0.25
