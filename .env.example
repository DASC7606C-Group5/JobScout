DATABASE_URL=sqlite://jobscout.sqlite3

LLM_SEMANTIC_PROVIDER=deepseek
LLM_SEMANTIC_MODEL=deepseek-flash
LLM_SEMANTIC_BASE_URL=https://api.deepseek.com
LLM_SEMANTIC_API_KEY=

LLM_DECISION_PROVIDER=deepseek
LLM_DECISION_MODEL=deepseek-flash
LLM_DECISION_BASE_URL=https://api.deepseek.com
LLM_DECISION_API_KEY=

LLM_TIMEOUT=120
LLM_MAX_TOKENS=16384

# For testing
# Start the offline backend with: uv run --locked uvicorn replay.app:app --port 8018
