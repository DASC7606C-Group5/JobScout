# Copy to .env.deploy for Docker Compose deployment.
# Start: docker compose --env-file .env.deploy up --build -d
# Compose sets PRODUCTION, COOKIE_SECURE, PUBLIC_ORIGIN and DATABASE_URL.

# Public domain
DOMAIN=jobscout.example.com

# Generate a persistent key: uv run python -m jobscout.manage generate-secrets
CREDENTIALS_KEY=

# Semantic model
LLM_SEMANTIC_PROVIDER=deepseek
LLM_SEMANTIC_MODEL=deepseek-flash
LLM_SEMANTIC_BASE_URL=https://api.deepseek.com
LLM_SEMANTIC_API_KEY=
LLM_SEMANTIC_THINKING=true
LLM_SEMANTIC_THINKING_LEVEL=low

# Decision model
LLM_DECISION_PROVIDER=deepseek
LLM_DECISION_MODEL=deepseek-flash
LLM_DECISION_BASE_URL=https://api.deepseek.com
LLM_DECISION_API_KEY=
LLM_DECISION_THINKING=true
LLM_DECISION_THINKING_LEVEL=high

# Model requests (timeout in seconds)
LLM_TIMEOUT=120
LLM_MAX_TOKENS=16384

# Optional model endpoints as JSON, keyed by endpoint ID (name, base_url, provider).
MODEL_ENDPOINTS={}

# Daily operation limits and concurrent operations
SERVER_DAILY_USER_LIMIT=8
SERVER_DAILY_TOTAL_LIMIT=1200
CONCURRENT_USER_LIMIT=1
CONCURRENT_TOTAL_LIMIT=128

# Operation queue (wait and scan intervals in seconds)
QUEUE_LIMIT=150
QUEUE_WAIT_SECONDS=14400
QUEUE_SCAN_SECONDS=5

# Authentication request limits and password hashing
AUTH_REGISTER_IP_LIMIT=300
AUTH_LOGIN_IP_LIMIT=300
AUTH_USERNAME_LIMIT=10
PASSWORD_HASH_CONCURRENCY=2

# Resume uploads and parsing (timeout in seconds, file size in bytes)
UPLOAD_CONCURRENCY=4
UPLOAD_TIMEOUT_SECONDS=30
RESUME_PARSE_CONCURRENCY=1
RESUME_MAX_BYTES=3145728
RESUME_MAX_PDF_PAGES=10
RESUME_MAX_TEXT_CHARACTERS=30000

# Concurrent model calls and job retrieval requests
MODEL_CALL_CONCURRENCY=96
RETRIEVAL_CONCURRENCY=8

# Public response cache (size in bytes)
PUBLIC_CACHE_BYTES=16777216

# Session cache (size in bytes, lifetime in seconds)
SESSION_CACHE_ENTRIES=16
SESSION_CACHE_BYTES=8388608
SESSION_CACHE_SECONDS=900

# Event streams
EVENT_STREAMS_PER_USER=2

# Operation cleanup and retention (intervals in seconds)
CLEANUP_INTERVAL_SECONDS=300
CLEANUP_BATCH_SIZE=100
OPERATION_RETENTION_SECONDS=172800

# SQLite lock wait timeout in milliseconds
SQLITE_BUSY_TIMEOUT_MS=5000
