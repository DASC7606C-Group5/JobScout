{
  "name": "@jobscout/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "test": "bun test src",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --port 3000",
    "doctor": "react-doctor --no-telemetry --no-supply-chain --output-dir .tools/doctor",
    "generate:api": "uv run --project .. --locked python ../scripts/export_openapi.py && bun install --cwd codegen --frozen-lockfile && bun run --cwd codegen generate && oxfmt --write src/api"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "axios": "^1.20.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "daisyui": "^5.7.47",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react-doctor": "^0.9.17",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
