{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "sortImports": {},
  "sortTailwindcss": { "stylesheet": "./src/styles.css" },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "bun.lock",
    "package-lock.json",
    "dist/**",
    ".tanstack/**",
    ".agents/**",
    ".tools/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
